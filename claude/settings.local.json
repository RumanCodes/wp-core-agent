{
  "permissions": {
    "allow": [
      "Bash(.claude/wp-tools/*)",
      "Bash(npm run test:php *)",
      "Bash(npm run test:e2e *)",
      "Bash(npm run env:start*)",
      "Bash(npm run env:stop*)",
      "Bash(npm run env:install*)",
      "Bash(npm run env:cli *)",
      "Bash(npm run build:dev*)",
      "Bash(npm run lint*)",
      "Bash(composer lint*)",
      "Bash(composer compat*)",
      "Bash(vendor/bin/phpcs *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git fetch*)",
      "Bash(git branch*)",
      "Bash(git switch*)",
      "Bash(git checkout*)",
      "Bash(git rebase upstream/trunk*)",
      "Bash(git merge-base*)",
      "Bash(git rev-parse*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh auth status*)",
      "WebFetch(domain:core.trac.wordpress.org)",
      "WebFetch(domain:make.wordpress.org)",
      "WebFetch(domain:developer.wordpress.org)",
      "WebFetch(domain:github.com)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh api *)"
    ],
    "deny": [
      "Bash(git push upstream*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh repo delete*)",
      "Bash(git clean -fdx*)",
      "Read(~/.ssh/**)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh" },
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/precommit-phpcs.sh" }
        ]
      }
    ]
  }
}
